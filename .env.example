# ============================================================
# Environment Configuration (.env.example)
# Copy this file to .env and configure your values
# ============================================================

# Comma-separated API keys for LiteLLM failover (minimum 2 keys)
LLM_API_KEYS=your_first_api_key_here,your_second_api_key_here

# Model name supported by LiteLLM (e.g. gpt-4o-mini, gemini/gemini-1.5-flash, groq/llama-3.1-8b-instant)
LLM_MODEL=gpt-4o-mini

# SQLite database file URL (use /data for Docker persistence, ./chat.db for local)
DATABASE_URL=sqlite:///./chat.db

# Allowed CORS origins (comma-separated or * for all)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enable failure simulation via X-Simulate-Failure header (true/false)
ENABLE_FAILURE_SIMULATION=true

# LiteLLM offline configuration
LITELLM_LOCAL_MODEL_COST_MAP=True

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8000
